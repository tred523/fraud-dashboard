{
  "name": "fraud-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"node server/index.js\" \"npm run dev --prefix client\"",
    "dev:server": "node server/index.js",
    "dev:client": "npm run dev --prefix client",
    "start": "NODE_ENV=production node server/index.js",
    "build": "cd client && npm install && node node_modules/.bin/vite build",
    "setup": "npm install && npm install --prefix client"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0"
  }
}
